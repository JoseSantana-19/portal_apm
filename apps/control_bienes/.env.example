# Aplicacion
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Guayaquil
APP_URL=http://localhost/portuareaO/Control_binesC/

# SQL Server
DB_DRIVER=sqlsrv
DB_HOST=SERVIDOR\\INSTANCIA
DB_PORT=
DB_NAME=inventario
DB_USER=usuario_sql
DB_PASS=clave_sql
DB_TRUST_CERT=true

# Alternativa local (solo si el proyecto se adapta para SQLite)
DB_SQLITE_PATH=database.sqlite
