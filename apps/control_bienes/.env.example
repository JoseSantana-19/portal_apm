# Configuracion de Entorno - app embebida en Portal APM
# Copiar a ".env" y ajustar segun tu maquina.
APP_ENV=development
APP_DEBUG=true
# APP_URL autodetectada (subcarpeta /portal_apm/apps/control_bienes/)

# Base de Datos - misma instancia del Portal APM (Windows Authentication)
DB_DRIVER=sqlsrv
DB_HOST=.\VICTUS
DB_PORT=
DB_NAME=inventario
DB_USER=
DB_PASS=
DB_TRUST_CERT=true
DB_SQLITE_PATH=database.sqlite
