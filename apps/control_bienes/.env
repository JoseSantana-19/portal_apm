# Configuracion de Entorno - app embebida en Portal APM
APP_ENV=development
APP_DEBUG=true
# APP_URL autodetectada (subcarpeta /portal_apm/apps/control_bienes/)

# Base de Datos - misma instancia del Portal APM.
# DB_HOST/DB_USER/DB_PASS vacíos = heredan de config/connections.php
# (la config central del sistema). Completar acá SOLO si este módulo
# necesita apuntar a un servidor distinto al del resto del portal.
DB_DRIVER=sqlsrv
DB_HOST=
DB_PORT=
DB_NAME=inventario
DB_USER=
DB_PASS=
DB_TRUST_CERT=true
DB_SQLITE_PATH=database.sqlite