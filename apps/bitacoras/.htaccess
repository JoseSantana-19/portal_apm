<IfModule mod_rewrite.c>
    RewriteEngine On

    # Archivos/carpetas reales (public/, apis/*.php, pendientes/*.php, dbf/)
    # se sirven directo — nunca pasan por el router.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
