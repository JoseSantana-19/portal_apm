# Copiar este archivo a ".env" (o setear estas variables como variables de
# entorno de Windows / del servicio) y ajustar según el servidor real.
# NINGUNA de estas es necesaria si SQL Server está en localhost\SQLEXPRESS
# con autenticación de Windows (Trusted_Connection) — son los valores por
# defecto si no se define nada.

APM_DB_DRIVER={ODBC Driver 17 for SQL Server}
APM_DB_SERVER=.\VICTUS
APM_DB_NAME=PortuariaDemo
APM_DB_TRUSTED=yes

# Si APM_DB_TRUSTED=no, se necesitan además:
# APM_DB_UID=sa
# APM_DB_PWD=

# URL base del sistema PHP (Portal APM), para el link "Abrir expediente completo".
APM_PHP_BASE_URL=http://localhost/portal_apm
